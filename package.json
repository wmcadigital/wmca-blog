{
  "name": "wmca-blog",
  "version": "1.0.0",
  "description": "WMCA Blog",
  "scripts": {
    "dev": "node ./scripts/start-dev.js",
    "build": "parcel build src/index.html",
    "lhci:collect": "lhci collect --config=./.lighthouserc.json",
    "lhci:assert": "lhci assert --config=./.lighthouserc.json",
    "lhci": "npm run lhci:collect && npm run lhci:assert",
    "sitemap": "node scripts/generate-sitemap.js",
    "test": "npm test --silent -- --runInBand",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "npm run lint --silent",
    "upgrade-deps": "npx npm-check-updates -u && npm install",
    "ncu": "npx npm-check-updates"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@lhci/cli": "^0.11.0",
    "@testing-library/dom": "^8.13.0",
    "@testing-library/react": "^13.1.1",
    "@testing-library/user-event": "^14.1.1",
    "eslint": "^7.18.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^26.1.4",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "jest": "^27.5.1",
    "parcel": "^2.4.1",
    "prettier": "^2.6.2",
    "process": "^0.11.10",
    "react-test-renderer": "^18.0.0",
    "source-map-explorer": "^2.5.3",
    "npm-check-updates": "^16.0.0"
  },
  "dependencies": {
    "@swc/helpers": "^0.3.8",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-ga4": "^2.1.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.14.2"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "Edge >= 79",
    "not dead",
    "not ie 11"
  ],
  "targets": {
    "default": {
      "context": "browser",
      "includeNodeModules": true,
      "engines": {
        "browsers": [
          "last 2 Chrome versions",
          "last 2 Firefox versions",
          "last 2 Safari versions",
          "Edge >= 79"
        ]
      }
    }
  },
  "author": "",
  "license": "ISC"
}
